---
// HeroSection Component
---
<section class="hero-band">
  <div class="container">
    <div class="hero-inner">
      <div>
        <div class="hero-eyebrow"><span>🎓</span> Trusted by 5,000+ Students</div>
        <h1 class="hero-title">Unlock Your<br><span>Academic Potential</span><br>with Expert Tutors</h1>
        <p class="hero-desc">Based at Sana Square, Garden West, Karachi, My Tuition Center provides high-quality online courses, personal tutoring, and a comprehensive Learning Management System (LMS) for students across Pakistan.</p>
        <div class="hero-actions">
          <a href="/courses" class="btn btn-primary">Explore Courses</a>
          <a href="/auth" class="btn btn-secondary">Start Learning Free</a>
        </div>
        <div class="hero-stats">
          <div><div class="hero-stat-val">5,000+</div><div class="hero-stat-label">Active Students</div></div>
          <div><div class="hero-stat-val">98%</div><div class="hero-stat-label">Success Rate</div></div>
          <div><div class="hero-stat-val">120+</div><div class="hero-stat-label">Expert Tutors</div></div>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-img-wrap">
          <img src="https://images.unsplash.com/photo-1577896851231-70ef18881754?w=800&q=80" alt="Students learning together at Garden Tuition Center" />
        </div>
        <div class="hero-badge">
          <div class="hero-badge-icon">🏆</div>
          <div class="hero-badge-text">
            <strong>Top Rated Center</strong>
            <span>Best in class 2024–2025</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
