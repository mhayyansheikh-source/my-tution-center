---
// Footer Component
---
<footer id="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="nav-logo" style="margin-bottom:var(--sp-md); display:flex; align-items:center;">
          <div class="nav-logo-mark">M</div>
          <div><div class="nav-logo-text">My Tuition Center</div><div class="nav-logo-sub">Garden West, Karachi</div></div>
        </a>
        <p>Empowering students in Karachi and beyond to achieve their academic best through expert tutoring, personalised learning, and expert educators.</p>
        <div class="footer-newsletter">
          <div style="font-size:13px;font-weight:600;color:var(--color-ink)">Newsletter</div>
          <form onsubmit="event.preventDefault(); alert('Newsletter signup submitted!');">
            <input type="email" placeholder="Enter your email" required />
            <button type="submit">Subscribe</button>
          </form>
        </div>
      </div>
      <div class="footer-col">
        <h2>COURSES</h2>
        <ul>
          <li><a href="/courses?category=math">Mathematics</a></li>
          <li><a href="/courses?category=science">Sciences</a></li>
          <li><a href="/courses?category=english">English</a></li>
          <li><a href="/courses?category=prog">Computing</a></li>
          <li><a href="/courses?category=history">Humanities</a></li>
          <li><a href="/courses">View All Courses</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h3>Company</h3>
        <ul>
          <li><a href="/about">About Us</a></li>
          <li><a href="/tutors">Our Tutors</a></li>
          <li><a href="/auth?role=tutor">Become a Tutor</a></li>
          <li><a href="/about#mission">Our Mission</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Support</h4>
        <ul>
          <li><a href="/auth">Student Login</a></li>
          <li><a href="/help">Help Center</a></li>
          <li><a href="/trial">Book a Trial</a></li>
          <li><a href="/privacy">Privacy Policy</a></li>
          <li><a href="/terms">Terms of Service</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Connect</h4>
        <div class="footer-social">
          <a href="https://www.facebook.com/Tuitioncentergarden" target="_blank" rel="noopener noreferrer" title="Facebook" aria-label="Facebook">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 954 125 854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 073z"/></svg>
          </a>
          <!-- other social SVGs from original HTML -->
        </div>
        <div style="margin-top:var(--sp-lg)">
          <div style="font-size:13px;color:var(--color-muted);margin-bottom:var(--sp-xs)">📍 Sana Square, Nishtar Road, Garden West, Karachi 75540</div>
          <div style="font-size:13px;color:var(--color-muted);margin-bottom:var(--sp-xs)">📞 +92 370 3438352</div>
          <div style="font-size:13px;color:var(--color-muted);margin-bottom:var(--sp-xs)">✉️ mutuitioncenter01@gmail.com</div>
          <div style="font-size:13px;color:var(--color-muted)">🌐 mytuition-center.com</div>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© 2026 My Tuition Center. All rights reserved.</p>
      <p>
        <a href="/privacy" style="margin-right:var(--sp-md)">Privacy Policy</a>
        <a href="/terms" style="margin-right:var(--sp-md)">Terms of Service</a>
        <a class="footer-admin-link" href="/admin">Admin Access</a>
      </p>
    </div>
  </div>
</footer>
