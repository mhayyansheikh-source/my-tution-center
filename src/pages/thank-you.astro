---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Thank You - My Tuition Center">
  <main id="page-thank-you" class="page">
    <div class="container" style="max-width:600px; padding: var(--sp-xxl) 0; text-align:center;">
      <div style="font-size: 48px; margin-bottom:var(--sp-md);">🎉</div>
      <h1 class="display-sm" style="margin-bottom:var(--sp-sm);">Thank You!</h1>
      <p style="font-size:16px; color:var(--color-body); margin-bottom:var(--sp-lg);">We have received your enrollment request and payment receipt. Our academic team will verify the transaction and contact you via WhatsApp within 24 hours to set up your student portal.</p>
      <a href="/" class="btn btn-primary">Return to Home</a>
    </div>
  </main>
</Layout>
