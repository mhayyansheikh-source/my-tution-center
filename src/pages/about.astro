---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Us - My Tuition Center">
  <main id="page-about" class="page">
    <section class="about-hero">
      <div class="container">
        <div class="about-hero-inner">
          <div>
            <h1 class="display-lg" style="margin-bottom:var(--sp-lg)">Building the next generation of academic leaders</h1>
            <p style="font-size:16px;color:var(--color-body);line-height:1.6;max-width:520px;margin-bottom:var(--sp-xl)">Founded in 2009 at Sana Square on Nishtar Road, My Tuition Center was born from a simple belief: every student in Karachi and beyond deserves access to comprehensive tutoring. What started as a small Garden West community centre has grown into a premier institution serving thousands of learners across Pakistan.</p>
            <div style="display:flex;gap:var(--sp-sm)">
              <a href="/courses" class="btn btn-primary">Explore Programs</a>
              <a href="/tutors" class="btn btn-secondary">Meet Our Tutors</a>
            </div>
          </div>
          <div class="about-hero-img">
            <img src="https://images.unsplash.com/photo-1529390079861-591de354faf5?w=800&q=80" alt="Students at Garden Tuition Center campus" />
          </div>
        </div>
      </div>
    </section>

    <section class="section-pad">
      <div class="container">
        <div class="mission-block">
          <div>
            <h2 id="mission" class="display-md" style="margin-bottom:var(--sp-lg)">Education that empowers, not just prepares</h2>
            <p style="font-size: 16px;color:var(--color-body);line-height:1.6;margin-bottom:var(--sp-lg)">We don't just teach to the exam. Our mission is to cultivate deep understanding, critical thinking, and a lifelong love of learning. We believe education should equip students with the skills to navigate an ever-changing world, not just pass tomorrow's test.</p>
            <p style="font-size: 16px;color:var(--color-body);line-height:1.6">Every programme at Garden Tuition Center is built around evidence-based pedagogy, personalised pacing, and continuous feedback loops that give students and parents real insight into progress.</p>
          </div>
          <div class="mission-img">
            <img src="https://images.unsplash.com/photo-1588072432836-e10032774350?w=800&q=80" alt="Tutor explaining concepts on whiteboard" />
          </div>
        </div>
      </div>
    </section>

    <section class="section-pad" style="padding-top:0">
      <div class="container">
        <div class="section-header centered">
          <h2 class="display-md">What we stand for</h2>
        </div>
        <div class="values-grid">
          <div class="value-card"><h3>Excellence in Teaching</h3><p>We hold our tutors to the highest standards, continuous professional development, structured lesson planning, and regular student feedback reviews.</p></div>
          <div class="value-card"><h3>Student-Centred Learning</h3><p>We listen before we teach. Every student's learning style, pace, and goals shape their programme from day one.</p></div>
          <div class="value-card"><h3>Transparency & Trust</h3><p>Parents and students get full visibility into progress through weekly reports, live dashboards, and open communication channels.</p></div>
          <div class="value-card"><h3>Inclusive Access</h3><p>Scholarship places, flexible pricing, and remote learning options ensure no student is left behind due to circumstance.</p></div>
          <div class="value-card"><h3>Innovation in Education</h3><p>We embrace technology thoughtfully, AI-assisted practice sets, adaptive quizzing, and collaborative digital tools that enhance great teaching.</p></div>
          <div class="value-card"><h3>Community Impact</h3><p>We invest in the communities we serve, free workshops, parent education nights, and scholarship programmes that give back beyond the classroom.</p></div>
        </div>
      </div>
    </section>

    <section style="padding:0 0 var(--sp-section)">
      <div class="container">
        <div class="sig-forest-card">
          <h2>What sets us apart from every other tuition centre</h2>
          <p>We don't run a factory. Every student at Garden is known by name, by strength, and by aspiration. Our average class sizes of 6 or fewer mean every session is practically one-on-one. That's the Garden difference.</p>
          <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:var(--sp-lg)">
            <div style="background:rgba(255,255,255,.08);border-radius:var(--r-md);padding:var(--sp-lg)"><div style="font-size:24px;font-weight:600;color:#fff;margin-bottom:var(--sp-xs)">≤6</div><div style="font-size:13px;color:rgba(255,255,255,.65)">Students per class</div></div>
            <div style="background:rgba(255,255,255,.08);border-radius:var(--r-md);padding:var(--sp-lg)"><div style="font-size:24px;font-weight:600;color:#fff;margin-bottom:var(--sp-xs)">48h</div><div style="font-size:13px;color:rgba(255,255,255,.65)">Max response time</div></div>
            <div style="background:rgba(255,255,255,.08);border-radius:var(--r-md);padding:var(--sp-lg)"><div style="font-size:24px;font-weight:600;color:#fff;margin-bottom:var(--sp-xs)">100%</div><div style="font-size:13px;color:rgba(255,255,255,.65)">Money-back guarantee</div></div>
          </div>
        </div>
      </div>
    </section>

    <section style="padding:0 0 var(--sp-section)">
      <div class="container">
        <div class="cta-band">
          <h2>Join the Garden Tuition family today</h2>
          <div class="cta-band-actions">
            <a href="/auth" class="btn btn-primary">Enroll Now</a>
            <a href="/contact" class="btn btn-secondary">Get in Touch</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
