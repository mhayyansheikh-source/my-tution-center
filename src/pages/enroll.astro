---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Enroll - My Tuition Center">
  <main id="page-enroll" class="page">
    <div class="container" style="max-width:600px; padding: var(--sp-xxl) 0;">
      <div style="text-align:center; margin-bottom:var(--sp-xl);">
        <h1 class="display-sm">Complete Your Enrollment</h1>
        <p style="color:var(--color-muted);">You are enrolling in: <strong id="enroll-course-title" style="color:var(--color-ink);">...</strong></p>
      </div>
      
      <div style="background:#fff; border:1px solid var(--color-hairline); border-radius:var(--r-lg); padding:var(--sp-xl); box-shadow:0 10px 30px rgba(0,0,0,0.03);">
        <form id="enroll-form" class="auth-form">
          <!-- Student Info -->
          <div class="form-row">
            <div class="form-group">
              <label>Student Full Name <span style="color:var(--color-primary)">*</span></label>
              <input type="text" class="form-control" required placeholder="e.g. Ali Khan" />
            </div>
            <div class="form-group">
              <label>Parent/Guardian Name</label>
              <input type="text" class="form-control" placeholder="e.g. Usman Khan" />
            </div>
          </div>
          
          <div class="form-row">
            <div class="form-group">
              <label>Email Address <span style="color:var(--color-primary)">*</span></label>
              <input type="email" class="form-control" required placeholder="you@example.com" />
            </div>
            <div class="form-group">
              <label>Phone / WhatsApp <span style="color:var(--color-primary)">*</span></label>
              <input type="tel" class="form-control" required placeholder="03xx xxxxxxx" />
            </div>
          </div>
          
          <div class="form-group">
            <label>Grade / Education Level <span style="color:var(--color-primary)">*</span></label>
            <select class="form-control" required>
              <option value="">Select level...</option>
              <option value="matric">Matriculation (Sindh Board)</option>
              <option value="olevel">O-Level (CAIE)</option>
              <option value="alevel">A-Level (CAIE)</option>
              <option value="uni">University / Professional</option>
              <option value="other">Other</option>
            </select>
          </div>

          <!-- Payment Section -->
          <div style="background:var(--color-surface); border:1px solid var(--color-hairline); padding:var(--sp-lg); border-radius:var(--r-md); margin:var(--sp-xl) 0;">
            <h2>Order Summary</h2>
            <div style="background:#fff; border:1px solid var(--color-hairline); padding:var(--sp-md); border-radius:var(--r-sm); margin-bottom:var(--sp-md);">
              <div style="display:flex; justify-content:space-between; margin-bottom:12px; border-bottom:1px solid var(--color-hairline); padding-bottom:12px;">
                <span style="color:var(--color-muted); font-size:14px;">Course</span>
                <strong id="enroll-summary-title" style="color:var(--color-ink); font-size:14px; text-align:right; max-width:60%;">...</strong>
              </div>
              <div style="display:flex; justify-content:space-between; margin-bottom:12px; border-bottom:1px solid var(--color-hairline); padding-bottom:12px;">
                <span style="color:var(--color-muted); font-size:14px;">Tutor</span>
                <strong id="enroll-summary-tutor" style="color:var(--color-ink); font-size:14px;">...</strong>
              </div>
              <div style="display:flex; justify-content:space-between; margin-bottom:12px; border-bottom:1px solid var(--color-hairline); padding-bottom:12px;">
                <span style="color:var(--color-muted); font-size:14px;">Format</span>
                <strong id="enroll-summary-format" style="color:var(--color-ink); font-size:14px;">...</strong>
              </div>
              <div style="display:flex; justify-content:space-between;">
                <span style="color:var(--color-ink); font-weight:600; font-size:16px;">Total to Pay</span>
                <strong id="enroll-course-price" style="color:var(--color-primary); font-size:16px;">...</strong>
              </div>
            </div>

            <h3 style="margin-bottom:var(--sp-sm); font-size:16px; margin-top:var(--sp-lg);">Payment Instructions</h3>
            <p style="font-size:14px; margin-bottom:var(--sp-md); color:var(--color-body);">Please transfer the total amount to secure your seat. Use the details below:</p>
            
            <div style="background:#fff; border:1px solid var(--color-hairline); padding:var(--sp-md); border-radius:var(--r-sm); font-family:monospace; font-size: 16px; line-height:1.6; margin-bottom:var(--sp-lg); display:inline-block; width:100%;">
              <div style="display:flex; justify-content:space-between; margin-bottom:4px;"><span style="color:var(--color-muted)">Method:</span> <strong style="color:var(--color-ink)">Jazzcash / Easypaisa</strong></div>
              <div style="display:flex; justify-content:space-between; margin-bottom:4px;"><span style="color:var(--color-muted)">Account No:</span> <strong style="color:var(--color-ink)">03379912300</strong></div>
              <div style="display:flex; justify-content:space-between;"><span style="color:var(--color-muted)">Title:</span> <strong style="color:var(--color-ink)">M Numan Latif</strong></div>
            </div>
            
            <div class="form-group" style="margin-bottom:0;">
              <label>Upload Payment Receipt <span style="color:var(--color-primary)">*</span></label>
              <div style="position:relative; border:2px dashed var(--color-hairline); border-radius:var(--r-sm); background:#fff; padding:var(--sp-md); text-align:center; transition:border-color .2s; cursor:pointer;" onmouseover="this.style.borderColor='var(--color-info-border)'" onmouseout="this.style.borderColor='var(--color-hairline)'">
                <input type="file" required accept="image/*,.pdf" style="opacity:0; position:absolute; inset:0; width:100%; height:100%; cursor:pointer;" />
                <div style="font-size:24px; margin-bottom:8px;">📄</div>
                <div style="font-size:14px; font-weight:500; color:var(--color-primary);">Click to upload receipt</div>
                <div style="font-size: 14px; color:var(--color-muted); margin-top:4px;">JPEG, PNG, or PDF (Max 5MB)</div>
              </div>
            </div>
          </div>

          <button type="submit" class="btn btn-primary" style="width:100%; height:48px; font-size:16px;">Submit Enrollment & Receipt</button>
        </form>
      </div>
    </div>
  </main>
</Layout>

<script>
  // Hydrate fields from query parameters on client side
  const params = new URLSearchParams(window.location.search);
  const title = params.get('course') || 'Selected Course';
  const price = params.get('price') || 'PKR 0';
  const tutor = params.get('tutor') || 'Expert Tutor';
  const format = params.get('format') || 'Online';

  document.getElementById('enroll-course-title').textContent = title;
  document.getElementById('enroll-summary-title').textContent = title;
  document.getElementById('enroll-summary-tutor').textContent = tutor;
  document.getElementById('enroll-summary-format').textContent = format;
  document.getElementById('enroll-course-price').textContent = price;

  const enrollForm = document.getElementById('enroll-form');
  if (enrollForm) {
    enrollForm.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('✓ Enrollment request submitted! We will verify your payment shortly.');
      window.location.href = '/thank-you';
    });
  }
</script>
