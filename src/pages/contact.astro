---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us - My Tuition Center">
  <main id="page-contact" class="page">
    <section style="background:var(--color-surface-soft);padding:var(--sp-xxl) 0">
      <div class="container">
        <h1 class="display-lg" style="margin-bottom:var(--sp-md)">We'd love to hear from you</h1>
        <p style="font-size:16px;color:var(--color-body);max-width:560px">Have a question about our courses, pricing, or tutoring? Our team is here to help.</p>
      </div>
    </section>

    <section class="section-pad">
      <div class="container">
        <div class="contact-grid">
          <div>
            <h2 class="title-lg" style="margin-bottom:var(--sp-xl)">Send us a message</h2>
            <form id="contact-form">
              <div class="form-row">
                <div class="form-group"><label>First Name</label><input class="form-control" name="first-name" type="text" placeholder="Jane" required /></div>
                <div class="form-group"><label>Last Name</label><input class="form-control" name="last-name" type="text" placeholder="Doe" required /></div>
              </div>
              <div class="form-group"><label>Email Address</label><input class="form-control" name="your-email" type="email" placeholder="jane@example.com" required /></div>
              <div class="form-group"><label>Phone (optional)</label><input class="form-control" name="your-phone" type="tel" placeholder="+1 (555) 000-0000" /></div>
              <div class="form-group"><label>Enquiry Type</label><select name="enquiry-type" class="form-control"><option>Course Information</option><option>Enrollment</option><option>Pricing &amp; Fees</option><option>Trial Class Booking</option><option>Tutor Application</option><option>Technical Support</option><option>Other</option></select></div>
              <div class="form-group"><label>Your Message</label><textarea class="form-control" name="your-message" rows="5" placeholder="Tell us how we can help…" required></textarea></div>
              <button type="submit" class="btn btn-primary">Send Message</button>
            </form>
          </div>
          <div>
            <h2 class="title-lg" style="margin-bottom:var(--sp-xl)">Contact information</h2>
            <div class="map-placeholder">
              <span>📍</span>
              <p>My Tuition Center</p>
              <p style="font-size: 14px;margin-top:4px;color:var(--color-border-strong)">Sana Square, Nishtar Road, Garden West, Karachi</p>
            </div>
            <div class="contact-info-item">
              <div class="contact-info-icon">📍</div>
              <div><strong>Address</strong><span>Sana Square, Nishtar Road<br>Garden West, Karachi 75540</span></div>
            </div>
            <div class="contact-info-item">
              <div class="contact-info-icon">📞</div>
              <div><strong>Phone</strong><span>+92 370 3438352</span></div>
            </div>
            <div class="contact-info-item">
              <div class="contact-info-icon">🌐</div>
              <div><strong>Website</strong><span><a href="https://mytuition-center.com" target="_blank" rel="noopener noreferrer" style="color:var(--color-link)">mytuition-center.com</a></span></div>
            </div>
            <div class="contact-info-item">
              <div class="contact-info-icon">✉️</div>
              <div><strong>Email</strong><span><a href="mailto:mutuitioncenter01@gmail.com" style="color:var(--color-link)">mutuitioncenter01@gmail.com</a></span></div>
            </div>
            <div class="contact-info-item">
              <div class="contact-info-icon" style="background:#181d26;color:#fff;font-weight:700">f</div>
              <div><strong>Facebook</strong><span><a href="https://www.facebook.com/Tuitioncentergarden" target="_blank" rel="noopener noreferrer" style="color:var(--color-link)">facebook.com/Tuitioncentergarden</a></span></div>
            </div>
            <h3 style="font-size:16px;font-weight:500;color:var(--color-ink);margin-bottom:var(--sp-md)">Operating Hours</h3>
            <table class="hours-table">
              <tr><td>Monday – Friday</td><td>8:00 AM – 9:00 PM</td></tr>
              <tr><td>Saturday</td><td>9:00 AM – 6:00 PM</td></tr>
              <tr><td>Sunday</td><td>10:00 AM – 4:00 PM</td></tr>
              <tr><td>Public Holidays</td><td>Closed</td></tr>
            </table>
          </div>
        </div>
      </div>
    </section>

    <section style="padding:0 0 var(--sp-section)">
      <div class="container">
        <div style="background:#181d26;border-radius:var(--r-lg);padding:var(--sp-xxl);display:flex;align-items:center;gap:var(--sp-xxl);flex-wrap:wrap">
          <div style="flex:1;min-width:240px">
            <div style="font-size:40px;margin-bottom:var(--sp-md)">📘</div>
            <h2 style="font-size:28px;font-weight:400;color:#fff;margin-bottom:var(--sp-sm)">Follow us on Facebook</h2>
            <p style="color:rgba(255,255,255,.8);font-size:16px;line-height:1.6">Stay up to date with new courses, free study tips, exam schedules, and community updates.</p>
          </div>
          <div>
            <a href="https://www.facebook.com/Tuitioncentergarden" target="_blank" rel="noopener noreferrer" class="btn" style="background:#fff;color:#181d26;border:none;font-weight:600">Visit Our Facebook Page →</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const contactForm = document.getElementById('contact-form');
  if (contactForm) {
    contactForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formElement = e.target as HTMLFormElement;
      const formData = new FormData(formElement);
      const API_URL = import.meta.env.PUBLIC_WP_API_URL;
      
      try {
        // ID 1 is standard for WP Contact Form 7
        const res = await fetch(`${API_URL}/contact-form-7/v1/contact-forms/1/feedback`, {
          method: 'POST',
          body: formData
        });
        
        const result = await res.json();
        if(result.status === 'mail_sent') {
          alert('Form submitted successfully!');
          formElement.reset();
          window.location.href = '/thank-you';
        } else {
          alert('Validation failed. Please check your inputs.');
        }
      } catch (err) {
        console.error('Form error:', err);
        alert('An error occurred while sending. Please try again.');
      }
    });
  }
</script>
