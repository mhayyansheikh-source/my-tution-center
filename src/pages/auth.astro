---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sign In - My Tuition Center">
  <main id="page-auth" class="page">
    <div class="auth-page">
      <div class="auth-visual">
        <img src="https://images.unsplash.com/photo-1523050854058-8df90110c9f1?w=1000&q=80" alt="Students studying in a bright library" />
        <div class="auth-visual-content">
          <h2>Your learning journey starts here</h2>
          <p>Join thousands of students who have transformed their academic performance with Garden Tuition Center.</p>
          <div class="auth-visual-stats">
            <div class="auth-visual-stat"><strong>5,000+</strong><span>Active Learners</span></div>
            <div class="auth-visual-stat"><strong>98%</strong><span>Pass Rate</span></div>
            <div class="auth-visual-stat"><strong>120+</strong><span>Tutors</span></div>
          </div>
        </div>
      </div>
      <div class="auth-form-panel">
        <div style="margin-bottom:var(--sp-xl)">
          <div class="nav-logo-mark" style="margin-bottom:var(--sp-sm)">G</div>
          <div style="font-size:13px;color:var(--color-muted)">My Tuition Center</div>
        </div>
        <div class="auth-tabs">
          <button class="auth-tab active" id="tab-signin" data-tab="signin">Sign In</button>
          <button class="auth-tab" id="tab-signup" data-tab="signup">Create Account</button>
        </div>

        <!-- SIGN IN -->
        <div class="auth-toggle-content active" id="content-signin">
          <h2 class="title-lg" style="margin-bottom:var(--sp-xs)">Welcome back</h2>
          <p class="body-md" style="margin-bottom:var(--sp-xl)">Sign in to access your courses and dashboard.</p>

          <form id="signin-form">
            <div class="form-group"><label for="signin-email">Email address</label><input class="form-control" type="email" id="signin-email" placeholder="you@example.com" required /></div>
            <div class="form-group"><label for="signin-password">Password</label><input class="form-control" type="password" id="signin-password" placeholder="Enter your password" required /></div>
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--sp-lg)">
              <label class="form-check"><input type="checkbox"> Remember me</label>
              <a class="text-link" style="font-size:14px; cursor:pointer;" onclick="alert('Password reset link sent. Check your inbox.')">Forgot password?</a>
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center">Sign In</button>
          </form>
          <p style="text-align:center;margin-top:var(--sp-lg);font-size:14px;color:var(--color-muted)">Don't have an account? <a class="text-link switch-link" data-target="signup" style="cursor:pointer;">Create one free →</a></p>
        </div>

        <!-- SIGN UP -->
        <div class="auth-toggle-content" id="content-signup">
          <h2 class="title-lg" style="margin-bottom:var(--sp-xs)">Create your account</h2>
          <p class="body-md" style="margin-bottom:var(--sp-xl)">Start your free trial, no credit card required.</p>

          <form id="signup-form">
            <div class="form-row">
              <div class="form-group"><label>First Name</label><input class="form-control" type="text" placeholder="Jane" required /></div>
              <div class="form-group"><label>Last Name</label><input class="form-control" type="text" placeholder="Doe" required /></div>
            </div>
            <div class="form-group"><label>Email Address</label><input class="form-control" type="email" placeholder="jane@example.com" required /></div>
            <div class="form-group"><label>Role</label><select class="form-control"><option>Student</option><option>Parent / Guardian</option><option>Lifelong Learner</option></select></div>
            <div class="form-group"><label>Grade / Year Level</label><select class="form-control"><option>Primary (Years 1–6)</option><option>Lower Secondary (Years 7–9)</option><option>Upper Secondary (Years 10–12)</option><option>A-Level / Pre-University</option><option>Adult / Professional</option></select></div>
            <div class="form-group"><label>Password</label><input class="form-control" type="password" placeholder="Min. 8 characters" required /></div>
            <label class="form-check" style="margin-bottom:var(--sp-lg)"><input type="checkbox" required> I agree to the <a href="/terms" class="text-link">Terms of Service</a> and <a href="/privacy" class="text-link">Privacy Policy</a></label>
            <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center">Create My Account</button>
          </form>
          <p style="text-align:center;margin-top:var(--sp-lg);font-size:14px;color:var(--color-muted)">Already have an account? <a class="text-link switch-link" data-target="signin" style="cursor:pointer;">Sign in →</a></p>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  // Tab switching logic
  const authTabs = document.querySelectorAll('.auth-tab');
  const toggleContents = document.querySelectorAll('.auth-toggle-content');
  const switchLinks = document.querySelectorAll('.switch-link');

  function switchAuthTab(tabId) {
    authTabs.forEach(t => t.classList.remove('active'));
    toggleContents.forEach(c => c.classList.remove('active'));
    
    const activeTab = document.getElementById(`tab-${tabId}`);
    const activeContent = document.getElementById(`content-${tabId}`);
    
    if (activeTab && activeContent) {
      activeTab.classList.add('active');
      activeContent.classList.add('active');
    }
  }

  authTabs.forEach(tab => {
    tab.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).getAttribute('data-tab');
      if (target) switchAuthTab(target);
    });
  });

  switchLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).getAttribute('data-target');
      if (target) switchAuthTab(target);
    });
  });

  // Handle URL parameters (e.g. ?role=tutor)
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('action') === 'signup') {
    switchAuthTab('signup');
  }

  // Form handlers
  const signinForm = document.getElementById('signin-form');
  const signupForm = document.getElementById('signup-form');

  if (signinForm) {
    signinForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('signin-email') as HTMLInputElement).value;
      const pass = (document.getElementById('signin-password') as HTMLInputElement).value;
      
      try {
        const res = await fetch('https://api.mytuitioncenter.pk/wp-json/jwt-auth/v1/token', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username: email, password: pass })
        });
        
        if (res.ok) {
          const data = await res.json();
          localStorage.setItem('wp_token', data.token);
          localStorage.setItem('wp_user', data.user_display_name);
          alert('Logged in successfully!');
          window.location.href = '/'; 
        } else {
          alert('Invalid credentials. Try again.');
        }
      } catch(err) {
        alert('Login failed. Ensure WordPress is running locally.');
      }
    });
  }

  if (signupForm) {
    signupForm.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('✓ Account created! Welcome to Garden Tuition Center.');
      window.location.href = '/';
    });
  }
</script>
